#!/usr/bin/env node
// Runs chrome-devtools-mcp for one mcpc session and ends it, together with the mcpc bridge
// that started this wrapper, after CDT_IDLE_SECS without requests or when the screen's
// Chromium stops answering on CDT_PORT. The next mcpc call starts both again.
'use strict';
const { spawn } = require('node:child_process');
const fs = require('node:fs');

const port = process.env.CDT_PORT;
const idleMs = (Number(process.env.CDT_IDLE_SECS) || 600) * 1000;
const checkMs = Number(process.env.CDT_CHECK_MS) || 5000;
const bridge = process.ppid;

const child = spawn('chrome-devtools-mcp', process.argv.slice(2), {
  stdio: ['pipe', 'pipe', 'inherit'],
});
let lastRequest = Date.now();
let ending = false;

function isRequest(line) {
  try {
    const message = JSON.parse(line);
    return typeof message.method === 'string' && message.method !== 'ping';
  } catch {
    return false;
  }
}

function bridgeIsMcpc() {
  if (bridge <= 1 || process.ppid !== bridge) return false;
  try {
    return fs.readFileSync(`/proc/${bridge}/cmdline`, 'utf8').includes('mcpc');
  } catch {
    return false;
  }
}

function finish(code) {
  if (ending) return;
  ending = true;
  child.kill('SIGKILL');
  if (bridgeIsMcpc()) process.kill(bridge, 'SIGTERM');
  process.exit(code);
}

let pending = '';
process.stdin.on('data', (chunk) => {
  pending += chunk;
  const lines = pending.split('\n');
  pending = lines.pop();
  if (lines.some(isRequest)) lastRequest = Date.now();
  child.stdin.write(chunk);
});
process.stdin.on('end', () => finish(0));
child.stdin.on('error', () => {});
child.stdout.pipe(process.stdout);
child.on('exit', (code) => finish(code ?? 1));

setInterval(() => {
  if (Date.now() - lastRequest > idleMs) finish(0);
}, 1000).unref();

let misses = 0;
setInterval(async () => {
  try {
    const response = await fetch(`http://127.0.0.1:${port}/json/version`, {
      signal: AbortSignal.timeout(2000),
    });
    if (!response.ok) throw new Error(String(response.status));
    misses = 0;
  } catch {
    if (++misses >= 2) finish(0);
  }
}, checkMs).unref();
