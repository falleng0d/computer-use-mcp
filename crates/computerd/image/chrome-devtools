#!/bin/bash
# Starts or stops chrome-devtools-mcp for this screen's Chromium, bridged by mcpc as @cdt-N.
set -u

config=/etc/computer/mcpc.json
usage() { echo "usage: chrome-devtools start|stop" >&2; exit 2; }

[ $# -eq 1 ] || usage
case "${DISPLAY:-}" in
  :[0-9]*) screen=${DISPLAY#:}; screen=${screen%%.*} ;;
  *)
    [ "$1" = stop ] && { echo "chrome-devtools: this session has no screen, nothing was running"; exit 0; }
    echo "this session has no screen yet, call computer_observe, launch_app or open_path first" >&2
    exit 1
    ;;
esac
session="cdt-$screen"
export CDT_PORT=$((9221 + screen))
export CDT_IDLE_SECS=${CDT_IDLE_SECS:-600}

case "$1" in
  start)
    if ! curl -fsS --max-time 3 "http://127.0.0.1:$CDT_PORT/json/version" >/dev/null 2>&1; then
      echo "no Chromium is running on this screen, open a page or launch the browser first" >&2
      exit 1
    fi
    if mcpc "@$session" tools-call list_pages '{}' >/dev/null 2>&1; then
      echo "chrome-devtools: @$session already running"
      echo "screen: $screen"
      exit 0
    fi
    mcpc "@$session" close >/dev/null 2>&1
    if ! out=$(mcpc connect "$config:cdt" "@$session" 2>&1); then
      echo "$out" >&2
      exit 1
    fi
    echo "chrome-devtools: @$session started"
    echo "screen: $screen"
    ;;
  stop)
    if mcpc "@$session" close >/dev/null 2>&1; then
      state=stopped
    else
      state="was not running"
    fi
    pkill -f "browserUrl=http://127.0.0.1:$CDT_PORT( |\$)" 2>/dev/null
    echo "chrome-devtools: @$session $state"
    ;;
  *) usage ;;
esac
